<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the Compose theme so launch never flashes white. -->
    <style name="Theme.Savvy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/savvy_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="savvy_bg">#F2EEF4</color>
</resources>
